{
  "rules": [
    {
      "regex": "\\?",
      "replacement": "help"
    },
    {
      "regex": "^/?rtp$",
      "replacement": "paid-rtp"
    },
    {
      "regex": "^/?rtp(\\s+(?!others(?:\\s|$)).*)$",
      "replacement": "paid-rtp$1"
    },
    {
      "regex": "^(.*\\brun\\s+)rtp$",
      "replacement": "$1paid-rtp"
    },
    {
      "regex": "^(.*\\brun\\s+)rtp(\\s+(?!others(?:\\s|$)).*)$",
      "replacement": "$1paid-rtp$2"
    },
    {
      "regex": "^/?tpaaccept\\s+(?!all$)(\\S+)$",
      "replacement": "paid-tpaaccept $1"
    },
    {
      "regex": "^(.*\\brun\\s+)tpaaccept\\s+(?!all(?:\\s|$))(\\S+)$",
      "replacement": "$1paid-tpaaccept $2"
    }
  ],
  "MOD_VERSION": "14.12.0"
}